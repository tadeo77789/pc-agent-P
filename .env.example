# Copy to .env and fill in. Never commit real values.

# Paula's voice. Empty key = replies only appear in the chat.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=86V9x9hrQds83qf7zaGn
ELEVENLABS_MODEL=eleven_flash_v2_5
# Speaking speed, 0.7 (slow) to 1.2 (fast); 1.0 keeps the voice's own pace
ELEVENLABS_SPEED=1.0

# Speech to text (runs locally; the model downloads on first start)
WHISPER_MODEL=small
WHISPER_LANGUAGE=es
# auto = GPU if the CUDA wheels are installed (pip install -e ".[gpu]"), else CPU
WHISPER_DEVICE=auto

RABBITMQ_URL=amqp://paula:paula@localhost:5672/
# Same value as in the hub .env (32+ chars)
AGENT_SHARED_SECRET=

WAKE_WORDS=paula,paula port
WAKE_WORD_MIN_CONFIDENCE=0.85
HOTKEY=ctrl+shift+p
HOTKEY_LISTEN_SECONDS=5
# Apps where only the hotkey works (fullscreen apps always count as games)
# (PioneerGame.exe = Arc Raiders)
EXCLUDED_APPS=discord.exe,zoom.exe,ms-teams.exe,teams.exe,pioneergame.exe

# Optional: your own app list for "abre ..." (JSON: {"name": "exe, path or URI"})
APPS_FILE=
# Where the Vosk wake-word model is stored (default: %LOCALAPPDATA%\PaulaPort\models)
MODELS_DIR=

LOG_LEVEL=INFO
